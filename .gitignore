# =============================================================================
# 数据与产物：这两类东西体积大、可再生、且可能含许可限制，一律不进版本库
# =============================================================================
# ACDC 数据集有使用条款，重新分发可能违规 —— 这是必须忽略 data/ 的核心理由，
# 不只是「因为文件大」。
data/raw/
data/interim/
data/processed/
data/external/
!data/**/.gitkeep

artifacts/checkpoints/
artifacts/logs/
artifacts/predictions/
artifacts/reports/
!artifacts/**/.gitkeep

# 模型权重（本地微调产物、下载的预训练权重）
*.pt
*.pth
*.ckpt
*.safetensors
*.bin
checkpoints/
weights/

# =============================================================================
# Python
# =============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
pip-wheel-metadata/

# 虚拟环境
.venv/
venv/
env/
ENV/

# =============================================================================
# 工具缓存
# =============================================================================
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.cache/
*.log

# Jupyter —— 但保留 notebook 本身
.ipynb_checkpoints/
*.ipynb_checkpoints

# =============================================================================
# 编辑器与系统
# =============================================================================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*~

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS（万一以后换机器）
.DS_Store

# =============================================================================
# 密钥与本地覆盖配置
# =============================================================================
.env
.env.*
!.env.example
configs/local/
secrets/

# =============================================================================
# 脚手架生成器（一次性工具，用完即删）
# =============================================================================
_scaffold_generate.py
